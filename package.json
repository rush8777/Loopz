{
  "name": "@movcues/sdk",
  "version": "0.1.0",
  "description": "Movcues analytics and in-app experiences SDK",
  "type": "module",
  "main": "./dist/sdk.esm.js",
  "module": "./dist/sdk.esm.js",
  "types": "./dist/types/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/module.d.ts",
      "import": "./dist/sdk.esm.js",
      "default": "./dist/sdk.esm.js"
    },
    "./cdn/sdk.js": "./dist/sdk.js",
    "./cdn/sdk.min.js": "./dist/sdk.min.js",
    "./cdn/v1.js": "./dist/v1.js",
    "./cdn/sdk-experiences.js": "./dist/sdk-experiences.js",
    "./cdn/sdk-experiences.min.js": "./dist/sdk-experiences.min.js",
    "./cdn/sdk-editor.js": "./dist/sdk-editor.js",
    "./cdn/sdk-editor.min.js": "./dist/sdk-editor.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "dist/sdk.js",
    "dist/sdk.min.js",
    "dist/v1.js",
    "dist/sdk-experiences.js",
    "dist/sdk-experiences.min.js",
    "dist/sdk-editor.js",
    "dist/sdk-editor.min.js"
  ],
  "scripts": {
    "build": "vite build && vite build --mode minify && vite build --mode experiences && vite build --mode experiences-minify && vite build --mode editor && vite build --mode editor-minify && vite build --mode geo-agent && vite build --mode geo-agent-minify && vite build --mode v1 && vite build --mode module && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "dev": "vite",
    "test:browser": "playwright test",
    "test:integration": "node scripts/runIntegration.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsdom": "^24.1.1",
    "terser": "^5.31.6",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "license": "MIT",
  "dependencies": {
    "postcss": "^8.5.32"
  }
}
