    "html": "<section class=\"movcues-widget customer-authored movcues-checklist movcues-checklist--compact\" data-movcues-widget-type=\"checklist\" data-movcues-checklist-role=\"root\"><div class=\"movcues-checklist__expanded\" data-movcues-checklist-view=\"expanded\"><header class=\"movcues-checklist__header\" data-movcues-checklist-role=\"header\"><div><h2 class=\"movcues-checklist__title\" data-movcues-checklist-role=\"title\">Getting started</h2><p class=\"movcues-checklist__description\" data-movcues-checklist-role=\"description\">A few quick steps to help you get value from the product.</p></div><button type=\"button\" class=\"movcues-checklist__collapse\" data-movcues-checklist-role=\"collapse\" aria-label=\"Collapse checklist\">−</button></header><div class=\"movcues-checklist__progress\" data-movcues-checklist-role=\"progress\"></div><div class=\"movcues-checklist__items\" data-movcues-checklist-role=\"items\"><button type=\"button\" class=\"movcues-checklist__item\" data-movcues-checklist-item-id=\"legacy_task\" data-movcues-checklist-role=\"item\"><span class=\"movcues-checklist__state\" data-movcues-checklist-item-role=\"state\">✓</span><span class=\"movcues-checklist__copy\"><span class=\"movcues-checklist__item-title\" data-movcues-checklist-item-role=\"title\">Complete your first task</span><span class=\"movcues-checklist__item-description\" data-movcues-checklist-item-role=\"description\">Connect this task to a Guide, destination, or Segment.</span></span></button></div></div><button type=\"button\" class=\"movcues-checklist__launcher\" data-movcues-checklist-view=\"launcher\"><span data-movcues-checklist-role=\"launcher-label\">Getting started</span><span class=\"movcues-checklist__count\" data-movcues-checklist-role=\"remaining-count\"></span></button><div class=\"movcues-checklist__completion\" data-movcues-checklist-view=\"completion\"><h2 data-movcues-checklist-role=\"completion-title\">You&#39;re all set!</h2><p data-movcues-checklist-role=\"completion-description\">You completed every onboarding task.</p><button type=\"button\" data-movcues-checklist-role=\"completion-acknowledge\">Done</button></div></section>",
    "css": ".movcues-widget{box-sizing:border-box;width:320px;max-width:calc(100vw - 32px);padding:16px;background:#fff;color:#111827;border:1px solid rgba(15,23,42,.1);border-radius:16px;font-family:ui-sans-serif,system-ui,sans-serif;box-shadow:0 24px 70px rgba(15,23,42,.2)}.movcues-widget [data-movcues-checklist-view]{display:none}.movcues-widget [data-movcues-checklist-view].is-active{display:block}.movcues-widget .movcues-checklist__header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.movcues-widget .movcues-checklist__title{margin:0;font-size:17px;line-height:1.25}.movcues-widget .movcues-checklist__description{margin:6px 0 0;color:#64748b;font-size:13px;line-height:1.45}.movcues-widget .movcues-checklist__collapse{border:0;background:transparent;color:#64748b;font-size:20px;cursor:pointer}.movcues-widget .movcues-checklist__progress{margin:16px 0 10px;color:#64748b;font-size:12px}.movcues-widget .movcues-checklist__items{display:grid;gap:8px}.movcues-widget .movcues-checklist__item{display:flex;width:100%;align-items:flex-start;gap:10px;padding:9px;border:0;border-radius:10px;background:#f8fafc;color:inherit;text-align:left;cursor:pointer}.movcues-widget .movcues-checklist__item[data-state=locked]{opacity:.5;cursor:not-allowed}.movcues-widget .movcues-checklist__item[data-state=completed] .movcues-checklist__state{background:#16a34a;color:#fff}.movcues-widget .movcues-checklist__state{display:grid;width:22px;height:22px;flex:0 0 22px;place-items:center;border:1px solid #cbd5e1;border-radius:99px;color:transparent;font-size:12px}.movcues-widget .movcues-checklist__copy{display:grid;gap:3px}.movcues-widget .movcues-checklist__item-title{font-size:14px;font-weight:700}.movcues-widget .movcues-checklist__item-description{color:#64748b;font-size:12px}.movcues-widget .movcues-checklist__launcher{width:100%;border:0;border-radius:12px;padding:12px 16px;background:#2563eb;color:#fff;font-weight:700;cursor:pointer}.movcues-widget .movcues-checklist__count{margin-left:8px;opacity:.8}.movcues-widget .movcues-checklist__completion h2{margin:0 0 8px;font-size:20px}.movcues-widget .movcues-checklist__completion p{margin:0 0 16px;color:#64748b}.movcues-widget .movcues-checklist__completion button{border:0;border-radius:9px;padding:10px 16px;background:#2563eb;color:#fff;font-weight:700;cursor:pointer}"
